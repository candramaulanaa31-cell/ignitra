# TLS in front of the API (Caddy gets and renews the certificate). Set on the API:
#   API_PUBLIC_URL=https://api.example.com   TRUST_PROXY=127.0.0.1
# Health and /metrics ports (4001, 4002) stay on 127.0.0.1 and are not proxied.
api.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:4000
}

# Optional: the web app on the same machine instead of Vercel. Build it (API_URL=http://127.0.0.1:4000
# pnpm build), then run it on loopback only, so it is reachable through Caddy and nowhere else:
#   cd /opt/ignitra/apps/web && node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
# Its /api/* proxies to API_URL, so cookies stay first-party.
# app.example.com {
# 	encode gzip
# 	reverse_proxy 127.0.0.1:3000
# }
