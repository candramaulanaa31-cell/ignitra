# IGNITRA HTTP API. Copy to /etc/systemd/system/, then: systemctl enable --now ignitra-api
[Unit]
Description=IGNITRA API
After=network-online.target
Wants=network-online.target

[Service]
User=ignitra
Group=ignitra
WorkingDirectory=/opt/ignitra/apps/api
EnvironmentFile=/etc/ignitra/ignitra.env
ExecStart=/usr/bin/env node node_modules/tsx/dist/cli.mjs src/main.ts
Restart=always
RestartSec=5
# The service shuts down gracefully on SIGTERM (10 s budget).
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
