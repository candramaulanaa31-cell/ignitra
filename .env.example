# ============================================================================
# IGNITRA environment template. Copy to `.env` at the repo root.
# All node services (api, listener, runner) read this file. Never commit `.env`.
# Keep comments on their own line: inline "# ..." after a value is not portable.
# ============================================================================

NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- Chain -----------------------------------------------------------------
# Robinhood Chain mainnet = 4663, testnet = 46630.
# RPC_URL_PRIMARY / EXPLORER_URL fall back to the chain preset when empty.
CHAIN_ID=4663
RPC_URL_PRIMARY=https://rpc.mainnet.chain.robinhood.com
# Free-tier provider recommended (the public RPC is rate limited).
RPC_URL_FALLBACK=
# Optional. The listener falls back to polling when empty.
WS_URL=
EXPLORER_URL=https://robinhoodchain.blockscout.com

# ---- Listener ----------------------------------------------------------------
# depth = head - CONFIRMATION_DEPTH (~2 s at 10 blocks/s)
# safe (~12 min) / finalized (~18 min) = L1-backed node tags
CONFIRMATION_STRATEGY=depth
CONFIRMATION_DEPTH=20
POLL_INTERVAL_MS=2000
# Starting eth_getLogs range; shrinks automatically when the node refuses it.
LOG_RANGE_MAX=2000
LOG_ADDRESS_CHUNK=100
# Blocks re-verified when a reorg below the confirmed cursor is detected.
REORG_REWIND_BLOCKS=1000
# Fresh database only. Empty = start at the current confirmed head (no replay).
LISTENER_START_BLOCK=
LISTENER_LAG_ALERT_BLOCKS=600
LISTENER_HEALTH_HOST=127.0.0.1
# 0 disables the listener health endpoint.
LISTENER_HEALTH_PORT=4001
# Blockscout PRO API (free key at dev.blockscout.com). Empty key = built-in ABIs only.
EXPLORER_API_URL=https://api.blockscout.com/4663
EXPLORER_API_KEY=

# ---- Matcher (events → queued runs) -----------------------------------------
# What the listener process runs: sync (ingestion), matcher, or both.
LISTENER_ROLES=sync,matcher
MATCHER_BATCH_SIZE=500
# Sampling interval of BALANCE_THRESHOLD / CONTRACT_DEPLOYED flows.
MATCHER_POLL_TRIGGERS_MS=15000
# Evaluation rows stored per flow per minute ("why didn't it run"); counters stay exact.
MATCHER_EVALUATIONS_PER_MINUTE=20
# Auto-pause a flow when events dropped by max_runs_per_hour reach factor × cap in an hour.
MATCHER_RUNAWAY_FACTOR=3

# ---- Database ----------------------------------------------------------------
# Real Postgres (Neon / Supabase / local) — required to run several services:
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Embedded PGlite (no install, ONE process at a time — fine for `pnpm dev:api`):
#   DATABASE_URL=pglite://.data/pglite   (path relative to the repo root)
#   DATABASE_URL=pglite://memory         (ephemeral, migrated on start)
DATABASE_URL=pglite://.data/pglite

# ---- Secrets -----------------------------------------------------------------
# Generate with: pnpm gen:secret
# Master key (KEK) for envelope encryption: base64, exactly 32 bytes.
ENCRYPTION_KEY=
# Key id written into every envelope. Change it when you rotate the key.
ENCRYPTION_KEY_ID=k1
# Optional decrypt-only old keys, e.g. "k0:<base64>,k00:<base64>".
ENCRYPTION_KEYS_PREVIOUS=

# Master for per-owner webhook signing secrets (inline-URL WEBHOOK steps).
# Generate with: pnpm gen:secret. Owners get theirs with: pnpm ops webhook secret --owner 0x..
WEBHOOK_SIGNING_SECRET=
# Web Push. Generate with: pnpm gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ---- Runner (executes queued runs) ---------------------------------------------
RUNNER_CONCURRENCY=4
RUNNER_POLL_MS=1000
RUNNER_LEASE_MS=60000
# Attempts per step (exponential backoff 10 s, 30 s, 90 s, …; Retry-After honoured).
RUNNER_MAX_ATTEMPTS=5
# Consecutive failed runs before a flow is auto-paused (the owner is notified).
RUNNER_AUTOPAUSE_FAILURES=5
RUNNER_HEALTH_HOST=127.0.0.1
RUNNER_HEALTH_PORT=4002
OUTBOUND_TIMEOUT_MS=10000
# DEV ONLY: lets actions reach localhost / private networks (local webhook receivers).
OUTBOUND_ALLOW_PRIVATE=false
# Override only for tests/stubs.
TELEGRAM_API_URL=
# Set only when adding a Telegram connection: pnpm ops connection add telegram …
TELEGRAM_BOT_TOKEN=
# With embedded PGlite everything must run in ONE process:
#   LISTENER_ROLES=sync,matcher,runner pnpm dev:listener

# ---- Services ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Used server-side by apps/web to reach the API.
API_URL=http://localhost:4000
